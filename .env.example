# ------------------------------------------------------------------
# SANITY CMS — CONNECT PORTFOLIO CONTENT
# Copy this file to `.env.local` and fill in the values from your
# Sanity management dashboard (manage.sanity.io).
# ------------------------------------------------------------------

# Browser-exposed (used by the site at runtime to read content).
VITE_SANITY_PROJECT_ID="YOUR_SANITY_PROJECT_ID"
VITE_SANITY_DATASET="production"

# Node-only (write access). Needed ONLY by the write scripts — `npm run seed`
# and one-off content patches. The website and the prebuild snapshot both read
# the public dataset without a token, and this value is never exposed to the
# browser. Create it under Project -> API -> Tokens in the Sanity dashboard.
SANITY_TOKEN="sk_YOUR_WRITE_TOKEN"